{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(sha256sum:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./vendor/barcode-detector/pure.js)",
      "Read(./vendor/zxing-wasm/zxing_reader.wasm)",
      "Read(./panoptes-export-*.json)"
    ]
  }
}
